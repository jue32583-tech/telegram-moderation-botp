# Copy to .env and fill in your bot token. Never commit .env.
# Railway must use this exact variable name. Do not use BOT_TOKEN.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# The active bot uses these three fixed numeric Telegram IDs only.
TELEGRAM_ADMIN_IDS=6081621017,6940887457,6432487408

# JSON object: display name -> public @username or numeric channel ID.
TELEGRAM_SOURCE_CHANNELS={"AnimeMM User Links":"@animemmuserlinkcollection"}
TELEGRAM_TARGET_CHANNELS={"AnimeOngoing MM":"@AnimeOngoing_MM"}

# Optional runtime settings.
BOT_DATA_FILE=bot_data.json
LOG_LEVEL=INFO

# Optional text added to admin media drafts before manual reposting.
# DRAFT_PREFIX=🎬 Anime Update
# DRAFT_SUFFIX=#AnimeMM
